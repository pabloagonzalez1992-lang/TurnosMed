    {
      "name": "POST /medicos validación Zod 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nombre\":\"\",\"especialidad\":\"Cardiologia\",\"matricula\":\"CO-1002\",\"disponible\":true}"
        },
        "url": {
          "raw": "{{baseUrl}}/medicos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "medicos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Zod validation error returns 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Error body follows standardized JSON shape', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('status', 400);",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body).to.have.property('code', 'VALIDATION_ERROR');",
              "  pm.expect(body).to.have.property('details').that.is.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "POST /turnos validación Zod 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"paciente\":\"Luisa\",\"fecha\":\"2026-09-11\",\"hora\":\"99:00\",\"especialidad\":\"Cardiologia\",\"medicoId\":1,\"estado\":\"confirmado\"}"
        },
        "url": {
          "raw": "{{baseUrl}}/turnos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "turnos"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Zod validation error returns 400', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('Turno error response structure', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.have.property('status', 400);",
              "  pm.expect(body).to.have.property('message');",
              "  pm.expect(body).to.have.property('code', 'VALIDATION_ERROR');",
              "  pm.expect(body.details).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
