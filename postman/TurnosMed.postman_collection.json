    {
      "name": "GET /medicos con filtros query params",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/medicos?especialidad=Cardiologia&disponible=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "medicos"
          ],
          "query": [
            {
              "key": "especialidad",
              "value": "Cardiologia"
            },
            {
              "key": "disponible",
              "value": "true"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('GET medicos query params returns 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('GET medicos query params returns array', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
